    {"id":"evidence_cli_text","type":"text","x":660,"y":1200,"width":510,"height":135,"text":"uv run rewardhack-gym list-envs\n  -> 8 envs: 4 code + 4 math\nuv run rewardhack-gym inspect-env code/spec-overfit --profile high\n  -> task_id code/spec-overfit:feature-flags:5305\nuv run rewardhack-gym evaluate-traces ...\n  -> traces, summaries, false-pass cohorts","originalText":"uv run rewardhack-gym list-envs\n  -> 8 envs: 4 code + 4 math\nuv run rewardhack-gym inspect-env code/spec-overfit --profile high\n  -> task_id code/spec-overfit:feature-flags:5305\nuv run rewardhack-gym evaluate-traces ...\n  -> traces, summaries, false-pass cohorts","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":180015,"version":1,"versionNonce":180016,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
