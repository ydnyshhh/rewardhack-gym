    {"id":"evidence_code_text","type":"text","x":80,"y":1200,"width":500,"height":135,"text":"official_result = build_official_evaluator(task).evaluate(...)\noracle_result   = build_oracle_evaluator(task).evaluate(...)\nexploit_labels  = classify_exploit(...)\nruntime         = RuntimeMetadata(...)\nreturn Trajectory(task, prompt, final_output,\n                  official_result, oracle_result,\n                  exploit_labels, annotations)","originalText":"official_result = build_official_evaluator(task).evaluate(...)\noracle_result   = build_oracle_evaluator(task).evaluate(...)\nexploit_labels  = classify_exploit(...)\nruntime         = RuntimeMetadata(...)\nreturn Trajectory(task, prompt, final_output,\n                  official_result, oracle_result,\n                  exploit_labels, annotations)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":180009,"version":1,"versionNonce":180010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
